<!DOCTYPE html>
<html>
<head>
  <title>Agri Assist AI</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body {
      font-family: Arial;
      text-align: center;
      background: #e8f5e9;
      padding: 30px 15px;
    }
    .box {
      background: white;
      padding: 25px;
      border-radius: 15px;
      max-width: 400px;
      margin: auto;
    }
    button {
      background: green;
      color: white;
      padding: 12px 20px;
      border: none;
      border-radius: 8px;
      font-size: 16px;
    }
    #output {
      margin-top: 20px;
      color: #176b2c;
    }
  </style>
</head>
<body>
  <div class="box">
    <h1>🌱 Agri Assist AI</h1>
    <p>Smart Crop Disease Demo</p>

    <input type="file" id="photo" accept="image/*">
    <br><br>

    <button onclick="checkCrop()">Check Crop</button>

    <div id="output"></div>
  </div>

  <script>
    function checkCrop() {
      const photo = document.getElementById("photo").files[0];
      const output = document.getElementById("output");

      if (!photo) {
        output.innerHTML = "Please upload a leaf image!";
        return;
      }

      output.innerHTML = `
        <h2>✅ Analysis Complete</h2>
        <p><b>Crop:</b> Tomato (Demo)</p>
        <p><b>Status:</b> Possible Leaf Disease</p>
        <p><b>Confidence:</b> Demo Result</p>
        <p><b>Suggestion:</b> Check the leaf carefully
        and consult an agriculture expert.</p>
      `;
    }
  </script>
</body>
</html>
<!-- WEATHER ALERT -->
<section id="weather" class="screen">
  <button class="back" onclick="showScreen('home')">← Back</button>

  <h2>🌦️ Weather Alert</h2>

  <div class="big-card">
    <input
      type="text"
      id="city"
      placeholder="Enter city name (e.g. Chennai)"
    />

    <button onclick="getWeather()">Get Weather</button>

    <div id="weatherResult">
      Weather details will appear here.
    </div>

    <button onclick="speakWeather()">🔊 Tamil Voice</button>
  </div>
</section>


<!-- IRRIGATION REMINDER -->
<section id="irrigation" class="screen">
  <button class="back" onclick="showScreen('home')">← Back</button>

  <h2>💧 Irrigation Reminder</h2>

  <div class="big-card">
    <label for="crop">Select Your Crop:</label>

    <select id="crop">
      <option value="rice">Rice / நெல்</option>
      <option value="tomato">Tomato / தக்காளி</option>
      <option value="mango">Mango / மாம்பழம்</option>
      <option value="banana">Banana / வாழை</option>
      <option value="groundnut">Groundnut / நிலக்கடலை</option>
      <option value="cotton">Cotton / பருத்தி</option>
    </select>

    <button onclick="getIrrigation()">Check Irrigation</button>

    <div id="irrigationResult">
      Select a crop to get watering guidance.
    </div>

    <button onclick="speakIrrigation()">🔊 Tamil Voice</button>
  </div>
</section>
